# Copy to .env (git-ignored) and adjust. No real secrets belong in this file — it documents which
# environment variables the workbench reads. The application persists only environment-variable
# NAMES for target credentials; the values live in your shell / .env and are read at call time.

# --- Local LLM judge (Ollama) ---
# Base URL of the Ollama server (compose.yaml publishes it on localhost:11434).
OLLAMA_BASE_URL=http://localhost:11434
# Evaluator model used by the LLM judges. scripts/pull-models.sh pulls exactly this model.
OLLAMA_EVALUATOR_MODEL=llama3.2:3b
# Judge sampling temperature (keep 0.0 for reproducible verdicts).
OLLAMA_TEMPERATURE=0.0
# Maximum concurrent judge calls.
OLLAMA_MAX_CONCURRENCY=2

# --- Target-system credentials (example) ---
# When you configure a target with authenticationType BEARER_TOKEN or API_KEY_HEADER, you store
# the NAME of the environment variable holding the credential (e.g. "ACME_CHATBOT_TOKEN") on the
# target, then export that variable before starting the workbench:
# ACME_CHATBOT_TOKEN=replace-with-real-token-at-runtime
